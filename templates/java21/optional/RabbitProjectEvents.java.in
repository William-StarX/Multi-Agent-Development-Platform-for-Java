package @package@.runtime;

import java.util.UUID;
import java.util.concurrent.ExecutionException;
import java.util.concurrent.TimeUnit;
import java.util.concurrent.TimeoutException;
import org.springframework.amqp.core.Declarables;
import org.springframework.amqp.core.Message;
import org.springframework.amqp.core.QueueBuilder;
import org.springframework.amqp.rabbit.annotation.RabbitListener;
import org.springframework.amqp.rabbit.connection.CorrelationData;
import org.springframework.amqp.rabbit.core.RabbitTemplate;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.context.annotation.Primary;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.scheduling.annotation.EnableScheduling;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Component;
import org.springframework.transaction.annotation.Transactional;
import org.springframework.transaction.support.TransactionSynchronizationManager;

@Configuration(proxyBeanMethods = false)
@EnableScheduling
class ProjectQueueConfiguration {
    @Bean Declarables projectQueues() {
        return new Declarables(
                QueueBuilder.durable(RabbitProjectEvents.QUEUE).deadLetterExchange("")
                        .deadLetterRoutingKey(RabbitProjectEvents.QUEUE + ".dead").build(),
                QueueBuilder.durable(RabbitProjectEvents.QUEUE + ".dead").build());
    }
}

@Primary
@Component
class RabbitProjectEvents implements ProjectEvents {
    static final String QUEUE = "@service@.events";
    private record Event(UUID id, String type, String payload) {}
    private final JdbcTemplate jdbc;
    private final RabbitTemplate rabbit;

    RabbitProjectEvents(JdbcTemplate jdbc, RabbitTemplate rabbit) {
        this.jdbc = jdbc;
        this.rabbit = rabbit;
    }

    @Override
    public void record(UUID id, String type, String data) {
        if (!TransactionSynchronizationManager.isActualTransactionActive())
            throw new IllegalStateException("Write the outbox event in the business transaction.");
        jdbc.update("INSERT INTO jdda_outbox(event_id,event_type,payload) VALUES (?,?,?)", id, type, data);
    }

    @Scheduled(fixedDelay = 200)
    @Transactional
    public void publish() {
        var pending = jdbc.query("""
                SELECT event_id,event_type,payload FROM jdda_outbox WHERE published_at IS NULL
                ORDER BY created_at, event_id LIMIT 16 FOR UPDATE SKIP LOCKED
                """, (row, n) -> new Event(row.getObject(1, UUID.class), row.getString(2), row.getString(3)));
        for (var event : pending) {
            var correlation = new CorrelationData(event.id().toString());
            rabbit.convertAndSend("", QUEUE, event.payload(), message -> {
                message.getMessageProperties().setMessageId(event.id().toString());
                message.getMessageProperties().setType(event.type());
                return message;
            }, correlation);
            try {
                if (!correlation.getFuture().get(2, TimeUnit.SECONDS).isAck() || correlation.getReturned() != null)
                    throw new IllegalStateException("Outbox message was not confirmed.");
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
                throw new IllegalStateException("Outbox publish interrupted.", e);
            } catch (ExecutionException | TimeoutException e) {
                throw new IllegalStateException("Outbox confirmation unavailable.", e);
            }
            jdbc.update("UPDATE jdda_outbox SET published_at=now() WHERE event_id=?", event.id());
        }
    }

    @RabbitListener(queues = QUEUE)
    @Transactional
    public void receive(Message message) {
        UUID eventId = UUID.fromString(message.getMessageProperties().getMessageId());
        jdbc.update("INSERT INTO jdda_delivered_event(event_id,event_type) VALUES (?,?) ON CONFLICT DO NOTHING",
                eventId, message.getMessageProperties().getType());
    }
}
