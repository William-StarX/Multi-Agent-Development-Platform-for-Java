{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MADPJ execution contracts v1 draft",
  "oneOf": [
    {
      "$ref": "#/$defs/TaskPackage"
    },
    {
      "$ref": "#/$defs/TaskSnapshot"
    },
    {
      "$ref": "#/$defs/TaskAttempt"
    },
    {
      "$ref": "#/$defs/TaskLease"
    },
    {
      "$ref": "#/$defs/ResultSubmission"
    }
  ],
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "PositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "Counter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "Commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "Path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:\\u0000]+$"
    },
    "Artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "uri",
        "digest"
      ],
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/Identifier"
        },
        "uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "Dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "revision",
        "gate"
      ],
      "properties": {
        "taskId": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "gate": {
          "enum": [
            "VERIFIED",
            "INTEGRATED"
          ]
        },
        "artifact": {
          "$ref": "#/$defs/Artifact"
        }
      }
    },
    "Budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokenBudget",
        "costBudget"
      ],
      "properties": {
        "tokenBudget": {
          "$ref": "#/$defs/Counter"
        },
        "costBudget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "currency",
            "limit"
          ],
          "properties": {
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "limit": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
            }
          }
        }
      }
    },
    "TaskState": {
      "enum": [
        "DRAFT",
        "WAITING_DEPENDENCIES",
        "READY",
        "LEASED",
        "RUNNING",
        "VERIFYING",
        "RETRY_WAIT",
        "BLOCKED",
        "CANCEL_REQUESTED",
        "CANCELLED",
        "SUCCEEDED",
        "FAILED",
        "SUPERSEDED"
      ]
    },
    "TaskPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "taskId",
        "revision",
        "parentTaskId",
        "planVersion",
        "managerId",
        "topologyVersion",
        "repoId",
        "baseCommit",
        "contractVersion",
        "dependencies",
        "inputArtifacts",
        "ownedPaths",
        "requiredCapabilities",
        "toolPolicyId",
        "resources",
        "timeoutSeconds",
        "maxAttempts",
        "budget",
        "acceptanceProfile",
        "expectedArtifacts",
        "reviewPolicy"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1"
        },
        "projectId": {
          "$ref": "#/$defs/Identifier"
        },
        "taskId": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "parentTaskId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "planVersion": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "managerId": {
          "$ref": "#/$defs/Identifier"
        },
        "operatorGuidance": {"type": "boolean"},
        "delegation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["goal", "steps"],
          "properties": {
            "goal": {"type": "string", "minLength": 1, "maxLength": 1200, "pattern": "\\S"},
            "steps": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from", "to", "instruction"],
                "properties": {
                  "from": {"$ref": "#/$defs/Identifier"},
                  "to": {"$ref": "#/$defs/Identifier"},
                  "instruction": {"type": "string", "minLength": 1, "maxLength": 1200, "pattern": "\\S"},
                  "decisionSummary": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "\\S"}
                }
              }
            }
          }
        },
        "topologyVersion": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "repoId": {
          "$ref": "#/$defs/Identifier"
        },
        "baseCommit": {
          "$ref": "#/$defs/Commit"
        },
        "contractVersion": {
          "$ref": "#/$defs/Identifier"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Dependency"
          },
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "inputArtifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Artifact"
          },
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "ownedPaths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Path"
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "toolPolicyId": {
          "$ref": "#/$defs/Identifier"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu",
            "memoryMiB"
          ],
          "properties": {
            "cpu": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1024
            },
            "memoryMiB": {
              "$ref": "#/$defs/PositiveInteger"
            }
          }
        },
        "timeoutSeconds": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "maxAttempts": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "acceptanceProfile": {
          "$ref": "#/$defs/Identifier"
        },
        "expectedArtifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "reviewPolicy": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "TaskSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "taskId",
        "revision",
        "state",
        "rowVersion",
        "leaseEpoch",
        "currentAttemptId",
        "updatedAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1"
        },
        "projectId": {
          "$ref": "#/$defs/Identifier"
        },
        "taskId": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "state": {
          "$ref": "#/$defs/TaskState"
        },
        "rowVersion": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "leaseEpoch": {
          "$ref": "#/$defs/Counter"
        },
        "currentAttemptId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedAt": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "TaskAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "taskId",
        "revision",
        "attemptId",
        "attemptNumber",
        "leaseEpoch",
        "workerId",
        "hostId",
        "slotId",
        "state",
        "createdAt",
        "finishedAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1"
        },
        "projectId": {
          "$ref": "#/$defs/Identifier"
        },
        "taskId": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "attemptId": {
          "$ref": "#/$defs/Identifier"
        },
        "attemptNumber": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "leaseEpoch": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "workerId": {
          "$ref": "#/$defs/Identifier"
        },
        "hostId": {
          "$ref": "#/$defs/Identifier"
        },
        "slotId": {
          "$ref": "#/$defs/Identifier"
        },
        "state": {
          "enum": [
            "ALLOCATED",
            "RUNNING",
            "RESULT_SUBMITTED",
            "ACCEPTED",
            "REJECTED",
            "EXPIRED",
            "CANCELLED"
          ]
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "finishedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "TaskLease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "taskId",
        "revision",
        "attemptId",
        "leaseEpoch",
        "workerId",
        "issuedAt",
        "expiresAt",
        "lastHeartbeatAt",
        "status"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1"
        },
        "projectId": {
          "$ref": "#/$defs/Identifier"
        },
        "taskId": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "attemptId": {
          "$ref": "#/$defs/Identifier"
        },
        "leaseEpoch": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "workerId": {
          "$ref": "#/$defs/Identifier"
        },
        "issuedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "expiresAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "lastHeartbeatAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "status": {
          "enum": [
            "ACTIVE",
            "RELEASED",
            "EXPIRED",
            "REVOKED"
          ]
        }
      }
    },
    "ResultSubmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "taskId",
        "revision",
        "attemptId",
        "leaseEpoch",
        "outcome",
        "resultCommit",
        "resultDigest",
        "manifestUri",
        "evidence"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1"
        },
        "projectId": {
          "$ref": "#/$defs/Identifier"
        },
        "taskId": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "attemptId": {
          "$ref": "#/$defs/Identifier"
        },
        "leaseEpoch": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "outcome": {
          "enum": [
            "PASSED",
            "FAILED"
          ]
        },
        "resultCommit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Commit"
            },
            {
              "type": "null"
            }
          ]
        },
        "resultDigest": {
          "$ref": "#/$defs/Digest"
        },
        "manifestUri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Artifact"
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "PASSED"
              }
            }
          },
          "then": {
            "properties": {
              "resultCommit": {
                "$ref": "#/$defs/Commit"
              }
            }
          }
        }
      ]
    }
  }
}
