        },
        "projectId": {
          "$ref": "#/$defs/Identifier"
        },
        "taskId": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "attemptId": {
          "$ref": "#/$defs/Identifier"
        },
        "leaseEpoch": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "errorType": {
          "enum": [
            "TRANSIENT",
            "IMPLEMENTATION",
            "CONTRACT",
            "INTEGRATION",
