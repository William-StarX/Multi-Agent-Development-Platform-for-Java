      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "OPEN",
                  "ACKNOWLEDGED",
                  "ESCALATED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "assignedTo": {
                "$ref": "#/$defs/Identifier"
              }
            }
          }
        }
      ]
    },
    "IncidentDecisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reason",
        "deadline",
        "relatedTasks"
      ],
      "properties": {
        "decision": {
          "enum": [
            "REQUEST_INFO",
            "RETRY",
            "REPAIR",
            "REASSIGN",
            "CONTRACT_CHANGE",
            "ESCALATE",
            "HUMAN",
            "STOP"
          ]
        },
        "reason": {
          "$ref": "#/$defs/Text"
        },
        "deadline": {
          "$ref": "#/$defs/Timestamp"
        },
        "relatedTasks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "taskId",
              "revision"
            ],
            "properties": {
              "taskId": {
                "$ref": "#/$defs/Identifier"
              },
              "revision": {
                "$ref": "#/$defs/PositiveInteger"
              }
            }
          },
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true
        }
      }
    },
    "IncidentDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "decisionId",
        "incidentId",
        "incidentVersion",
        "actorId",
        "decidedAt",
        "decision",
        "reason",
        "deadline",
        "relatedTasks"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1"
        },
        "projectId": {
          "$ref": "#/$defs/Identifier"
        },
        "decisionId": {
          "$ref": "#/$defs/Identifier"
        },
        "incidentId": {
          "$ref": "#/$defs/Identifier"
        },
        "incidentVersion": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "actorId": {
          "$ref": "#/$defs/Identifier"
        },
        "decidedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "decision": {
          "enum": [
            "REQUEST_INFO",
            "RETRY",
            "REPAIR",
            "REASSIGN",
            "CONTRACT_CHANGE",
            "ESCALATE",
            "HUMAN",
            "STOP"
          ]
        },
        "reason": {
          "$ref": "#/$defs/Text"
        },
        "deadline": {
          "$ref": "#/$defs/Timestamp"
        },
        "relatedTasks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "taskId",
              "revision"
            ],
            "properties": {
              "taskId": {
                "$ref": "#/$defs/Identifier"
              },
              "revision": {
                "$ref": "#/$defs/PositiveInteger"
              }
            }
          },
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true
        }
      }
    },
    "EventEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "eventId",
        "eventType",
        "aggregateId",
        "aggregateVersion",
        "revision",
        "occurredAt",
        "traceId",
        "causationId",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1"
        },
        "projectId": {
          "$ref": "#/$defs/Identifier"
        },
        "eventId": {
          "$ref": "#/$defs/Identifier"
        },
        "eventType": {
          "enum": [
            "TASK_STATE_CHANGED",
            "AGENT_CHANGED",
            "APPROVAL_CHANGED",
            "INCIDENT_CHANGED"
          ]
        },
        "aggregateId": {
          "$ref": "#/$defs/Identifier"
        },
        "aggregateVersion": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/PositiveInteger"
            },
            {
              "type": "null"
            }
          ]
        },
        "occurredAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "traceId": {
          "$ref": "#/$defs/Identifier"
        },
        "causationId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "payload": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "TASK_STATE_CHANGED"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "execution.schema.json#/$defs/TaskSnapshot"
              },
              "revision": {
                "$ref": "#/$defs/PositiveInteger"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "AGENT_CHANGED"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/AgentNode"
              },
              "revision": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "APPROVAL_CHANGED"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/Approval"
              },
              "revision": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "INCIDENT_CHANGED"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/Incident"
              },
              "revision": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
