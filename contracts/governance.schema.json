        "reporterId": {
          "$ref": "#/$defs/Identifier"
        },
        "rowVersion": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "topologyVersion": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "escalationPath": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        },
        "escalationIndex": {
          "$ref": "#/$defs/Counter"
