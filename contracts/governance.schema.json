        },
        "firstSeenAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "lastSeenAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "baseCommit": {
          "$ref": "#/$defs/Commit"
        },
        "resultCommit": {
          "anyOf": [
